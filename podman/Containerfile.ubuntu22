FROM ubuntu:22.04

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies for OpenZFS DEB builds
RUN apt-get update && \
    apt-get install -y \
    build-essential \
    autoconf \
    automake \
    libtool \
    make \
    debhelper \
    dh-autoreconf \
    dh-dkms \
    dh-python \
    python3-all-dev \
    python3-setuptools \
    uuid-dev \
    libblkid-dev \
    libudev-dev \
    libattr1-dev \
    libacl1-dev \
    libssl-dev \
    libffi-dev \
    linux-headers-generic \
    pkg-config \
    git \
    wget \
    curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up build directory
WORKDIR /tmp/zfs-build

# Copy build script
COPY scripts/build-deb.sh /usr/local/bin/build-deb
RUN chmod +x /usr/local/bin/build-deb

# Default command
CMD ["/usr/local/bin/build-deb"]
